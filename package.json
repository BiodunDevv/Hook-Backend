{
  "name": "hook-api",
  "version": "1.0.0",
  "description": "Hook \u2014 q-commerce fashion marketplace backend",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "seed:categories": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-category-tree.ts",
    "migrate:categories": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/migrate-legacy-categories.ts",
    "seed:catalog": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-category-catalog.ts",
    "seed:banners": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-banners.ts",
    "seed:delivery-fees": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-delivery-state-fees.ts",
    "test:reliability": "tsx --test tests/reliability-*.test.ts",
    "test:deletion": "tsx --test tests/deletion-*.test.ts",
    "test:negotiation": "tsx --test tests/negotiation-*.test.ts",
    "docs:swagger": "node scripts/generate-swagger.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "nodemon --config nodemon.json",
    "start": "node dist/server.js",
    "start:dev": "npm run dev",
    "worker": "node dist/worker.js",
    "worker:dev": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/worker.ts",
    "start:debug": "node --inspect -r ts-node/register/transpile-only -r tsconfig-paths/register src/server.ts",
    "start:prod": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "seed": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/seeds/index.ts",
    "db:clear-orders": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/clear-orders.ts",
    "db:clear-market-associate-uploads": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/clear-market-associate-uploads.ts",
    "db:seed-market-associate-products": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-market-associate-products.ts",
    "db:sync-market-associate-product-options": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/sync-market-associate-product-options.ts",
    "db:seed-legal-content": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-legal-content.ts",
    "db:backfill-product-ids": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/backfill-product-ids.ts",
    "db:backfill-product-catalog": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/backfill-product-catalog-links.ts",
    "db:migrate-fulfilment-indexes": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/migrate-fulfilment-indexes.ts",
    "db:migrate-market-fulfilment": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/migrate-market-fulfilment.ts",
    "db:backfill-group-statuses": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/backfill-group-statuses.ts",
    "db:seed-earn-settings": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/seed-earn-settings.ts",
    "db:backfill-permissions": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/backfill-permissions.ts",
    "db:verify-indexes": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/verify-indexes.ts",
    "db:report-duplicates": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/report-duplicates.ts",
    "db:purge-sla": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/purge-sla.ts",
    "db:purge-exceptions": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/database/scripts/purge-exceptions.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "mongoose-lean-virtuals": "^2.1.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "socket.io": "^4.8.3",
    "swagger-ui-dist": "^5.32.8",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.62.0"
  }
}
