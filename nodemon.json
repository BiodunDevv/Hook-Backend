{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": ["dist", "uploads", "docs", "**/*.spec.ts", "**/*.test.ts"],
  "exec": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/server.ts",
  "signal": "SIGTERM",
  "delay": "300",
  "env": {
    "NODE_ENV": "development",
    "DOTENV_CONFIG_QUIET": "true"
  }
}
