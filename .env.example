# ============================================================
# HOOK API — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=Hook API
APP_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:3000
ACCOUNT_INVITATION_TTL_HOURS=48
SUPPORT_EMAIL=support@hook.africa
HOOK_OPS_EMAIL=ops@hook.africa

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>

# ---- Redis (optional accelerator: shared rate limits, Socket.IO adapter, BullMQ) ----
# SECRET. Set it only in the environment / secret store, never commit a real value.
# Use rediss:// (TLS) for any remote host; production refuses plaintext redis:// to a remote host.
# MongoDB stays the source of truth: with REDIS_URL unset everything falls back to MongoDB / in-memory.
REDIS_URL=
PACKAGE_CREDENTIAL_ENCRYPTION_KEY=<generate-a-long-random-secret>
REDIS_KEY_PREFIX=hook:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=500
# Set to false only for a self-signed dev Redis.
REDIS_TLS_REJECT_UNAUTHORIZED=true
# 'memory' keeps rate limits per process (skips a Redis round trip on every request). Use it in
# development when Redis is remote; leave unset in production so limits are shared across instances.
RATE_LIMIT_STORE=
# Set to false to disable the immediate outbox wake-up (the 3s scheduled drain still delivers).
OUTBOX_WAKE=true

# ---- Background jobs / reliability ----
# Production: run `npm run worker` (one or more replicas) and set this to false on API instances.
# Default: true outside production, false in production.
WORKER_IN_PROCESS=
# T1/T2 mutations (checkout, payments, refunds, custody...) reject requests with no Idempotency-Key.
# This is ON by default; no setting needed. Uncomment only to switch it off while old clients that do
# not send keys are still in the field (a warning header is returned instead).
# IDEMPOTENCY_ENFORCE=false
MONGODB_CONNECT_RETRIES=5

# ---- Account deletion ----
# Days a customer can still cancel after asking to delete their account.
ACCOUNT_DELETION_COOLING_OFF_DAYS=14

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_MINUTES=10

# ---- Google OAuth ----
# The native Google Sign-In SDK returns ID tokens issued to the Web client ID,
# so GOOGLE_WEB_CLIENT_ID is required for mobile sign-in to verify.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- Payments (Paystack Hosted Checkout) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-api.example.com/api/v1/payments/paystack/callback
PAYSTACK_APP_RETURN_URL=hook://payments/return

# ---- Email ----
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@hook.ng
BREVO_FROM_NAME=Hook

# ---- File Uploads ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=8
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
CLOUDINARY_CLOUD_NAME=df4f0usnh
CLOUDINARY_UPLOAD_PRESET=ProfileX
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hook
CLOUDINARY_UPLOADS_ENABLED=true
CATALOG_SIGNED_MEDIA_ENABLED=true
CATALOG_MEDIA_MAX_BYTES=10485760
ALLOWED_EXTERNAL_IMAGE_HOSTS=res.cloudinary.com,cloudinary.com,images.unsplash.com,plus.unsplash.com

# ---- Azure OpenAI (negotiation wording only) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---- Security / Docs / Limits ----
ENABLE_API_DOCS=false
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=40

# ---- Seed Admin Defaults ----
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=SEED_ADMIN_PASSWROD
SEED_ADMIN_FIRST_NAME=Hook
SEED_ADMIN_LAST_NAME=Admin
# SEED_ADMIN_PASSWROD is accepted as a compatibility alias for the shared seed password.

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Encrypts supplier bank account numbers at rest. Use a long random value in development.
VENDOR_PAYMENT_ENCRYPTION_KEY=
