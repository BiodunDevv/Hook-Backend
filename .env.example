# ============================================================
# HOOK API — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Hook API
APP_URL=http://localhost:3000

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=
MONGODB_DB_NAME=hook

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_MINUTES=10

# ---- Payment Gateways ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NOMBA_SECRET_KEY=
NOMBA_PUBLIC_KEY=

# ---- Notifications ----
TERMII_API_KEY=
TERMII_SENDER_ID=HookNG
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@hook.ng
BREVO_FROM_NAME=Hook

# ---- Maps / Logistics ----
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=8
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
CLOUDINARY_CLOUD_NAME=df4f0usnh
CLOUDINARY_UPLOAD_PRESET=ProfileX
CLOUDINARY_UPLOAD_FOLDER=hook

# ---- AI Negotiation (Azure OpenAI) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>
AZURE_OPENAI_MODEL_NAME=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-04-01-preview

# ---- Seed Admin Defaults ----
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_FIRST_NAME=Hook
SEED_ADMIN_LAST_NAME=Admin
ALLOW_WEAK_PRODUCTION_SEED=false

# ---- Throttle ----
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ---- CORS ----
CORS_ORIGINS=*
