# ============================================================
# HOOK API — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Hook API
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL / SQLite) ----
DB_TYPE=postgres           # "postgres" for production, "sqlite" for local dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hook_user
DB_PASSWORD=
DB_DATABASE=hook_db
DB_SSL=true                # true for Neon, false for local
DB_SYNCHRONIZE=true        # Auto-create tables. Set to false after first run!
# Or use full connection string (overrides individual fields):
DATABASE_URL=

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_MINUTES=10

# ---- Payment Gateways ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NOMBA_SECRET_KEY=
NOMBA_PUBLIC_KEY=

# ---- Notifications ----
TERMII_API_KEY=
TERMII_SENDER_ID=HookNG
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@hook.ng

# ---- Maps / Logistics ----
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---- AI Negotiation ----
AI_NEGOTIATOR_API_URL=
AI_NEGOTIATOR_API_KEY=

# ---- Admin Defaults ----
ADMIN_EMAIL=admin@hook.ng
ADMIN_PASSWORD=change_me_pls

# ---- Throttle ----
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ---- CORS ----
CORS_ORIGINS=*
