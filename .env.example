# ============================================================
# HOOK API — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=Hook API
APP_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:3000
ACCOUNT_INVITATION_TTL_HOURS=48
SUPPORT_EMAIL=support@hook.africa
HOOK_OPS_EMAIL=ops@hook.africa

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=
MONGODB_DB_NAME=hook

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_MINUTES=10

# ---- Google OAuth ----
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- OPay Payments ----
OPAY_PAYIN_MODE=test
OPAY_PAYIN_PUBLIC_KEY=
OPAY_PAYIN_SECRET_KEY=
OPAY_PAYIN_MERCHANT_ID=
OPAY_PAYIN_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/payments/opay
OPAY_PAYIN_RETURN_URL=hook://payments/return
OPAY_PAYIN_CANCEL_URL=hook://payments/cancel
OPAY_POD_ENABLED=false
OPAY_TOKENIZATION_ENABLED=false
DEFAULT_DELIVERY_FEE=3000
DELIVERY_VENDOR_SUBSIDY=0

# ---- Email ----
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@hook.ng
BREVO_FROM_NAME=Hook

# ---- File Uploads ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=8
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
CLOUDINARY_CLOUD_NAME=df4f0usnh
CLOUDINARY_UPLOAD_PRESET=ProfileX
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hook
CLOUDINARY_UPLOADS_ENABLED=true
CATALOG_SIGNED_MEDIA_ENABLED=true
CATALOG_MEDIA_MAX_BYTES=10485760
ALLOWED_EXTERNAL_IMAGE_HOSTS=res.cloudinary.com,cloudinary.com,images.unsplash.com,plus.unsplash.com

# ---- Azure OpenAI (negotiation wording only) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---- Security / Docs / Limits ----
ENABLE_API_DOCS=false
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=40

# ---- Seed Admin Defaults ----
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_FIRST_NAME=Hook
SEED_ADMIN_LAST_NAME=Admin
ALLOW_WEAK_PRODUCTION_SEED=false

# Set only for a reviewed migration run after a verified backup.
PHASE_03_MIGRATION_CONFIRMED=false
PHASE_03_ROLLBACK_CONFIRMED=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
