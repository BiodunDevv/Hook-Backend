# ============================================================
# HOOK API — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Hook API
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL / SQLite) ----
DB_TYPE=postgres           # "postgres" for production, "sqlite" for local dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hook_user
DB_PASSWORD=
DB_DATABASE=hook_db
DB_SSL=true                # true for Neon, false for local
DB_SYNCHRONIZE=true        # Auto-create tables. Set to false after first run!
DB_LOGGING=false
# Or use full connection string (overrides individual fields):
DATABASE_URL=

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_MINUTES=10

# ---- Payment Gateways ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NOMBA_SECRET_KEY=
NOMBA_PUBLIC_KEY=

# ---- Notifications ----
TERMII_API_KEY=
TERMII_SENDER_ID=HookNG
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@hook.ng
BREVO_FROM_NAME=Hook

# ---- Maps / Logistics ----
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=8
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ---- AI Negotiation ----
AI_NEGOTIATOR_API_URL=
AI_NEGOTIATOR_API_KEY=

# ---- Seed Admin Defaults ----
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_FIRST_NAME=Hook
SEED_ADMIN_LAST_NAME=Admin
ALLOW_WEAK_PRODUCTION_SEED=false

# ---- Throttle ----
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ---- CORS ----
CORS_ORIGINS=*
